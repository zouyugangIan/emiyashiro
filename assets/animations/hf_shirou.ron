// assets/animations/hf_shirou.ron
{
    "Idle": (
        // Authored locomotion atlas; bounds and origins live in locomotion.json.
        frames: [0, 1, 2, 3],
        frame_duration: 0.14,
        playback_mode: "PingPong",
    ),
    "Running": (
        // Eight poses spanning both halves of the stride.
        frames: [4, 5, 6, 7, 8, 9, 10, 11],
        frame_duration: 0.055,
        playback_mode: "Loop",
        speed_scale_by_velocity: true,
        speed_reference: 250.0,
        min_frame_duration: 0.035,
    ),
    "Attacking": (
        // attack sheet row 0 (windup -> slash -> recovery)
        frames: [0, 1, 2, 3],
        frame_duration: 0.07,
        playback_mode: "Once",
    ),
    "Jumping": (
        // Takeoff -> tucked apex -> feet prepared for landing.
        frames: [12, 13, 14],
        frame_duration: 0.12,
        playback_mode: "Once",
    ),
    "Crouching": (
        // Settle on the intact grounded crouch, never show the airborne fall pose.
        frames: [15, 15],
        frame_duration: 0.07,
        playback_mode: "Once",
    ),
    "Landing": (
        // short landing settle
        frames: [15, 0],
        frame_duration: 0.055,
        playback_mode: "Once",
    )
}
